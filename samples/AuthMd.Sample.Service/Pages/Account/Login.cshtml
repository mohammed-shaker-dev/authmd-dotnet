@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<h1>Sign in</h1>
<p class="muted">The demo account is <code>@DemoUser.Email</code> / <code>@DemoUser.Password</code>.</p>

<form method="post">
    <label for="email">Email</label>
    <input id="email" name="Email" type="email" value="@Model.Email" autocomplete="username" required />

    <label for="password">Password</label>
    <input id="password" name="Password" type="password" autocomplete="current-password" required />

    @if (Model.Failed)
    {
        <p class="error">That email and password don't match an account.</p>
    }

    <button type="submit">Sign in</button>
</form>
