@page
@model RegisterModel
@{
    ViewData["Title"] = "Create an account";
}

<h1>Create an account</h1>
<p class="muted">Use the email address your agent registered with.</p>

<form method="post">
    <label for="email">Email</label>
    <input id="email" name="Email" type="email" value="@Model.Email" autocomplete="username" required />

    <label for="password">Password</label>
    <input id="password" name="Password" type="password" autocomplete="new-password" required />
    <p class="muted">At least 6 characters, with an uppercase letter, a lowercase letter, a digit and a symbol.</p>

    @foreach (var problem in Model.Problems)
    {
        <p class="error">@problem</p>
    }

    <button type="submit">Create account</button>
</form>

<p>Already have an account? <a asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a></p>
